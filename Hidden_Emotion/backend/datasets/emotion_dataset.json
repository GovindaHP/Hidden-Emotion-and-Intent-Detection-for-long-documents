  "hidden_emotion_rules": [
    {
      "pattern": "\\b(return|refund|policy|unfortunate|procedure|straightforward|misunderstanding)\\b.*\\b(rather|hope|believe|applicable)\\b",
      "hidden_emotion": "Calm Determination with Residual Disappointment"
    },
    {
      "pattern": "\\b(cooperate|documentation|procedure|not expecting special treatment)\\b",
      "hidden_emotion": "Calm Determination with Residual Disappointment"
    },
    {
      "pattern": "\\b(fine|okay|whatever|no problem)\\b.*\\b(anyway|suppose|nevermind)\\b",
      "hidden_emotion": "Repressed Frustration Behind Civility"
    },
    {
      "pattern": "\\b(strict|rules|permission|opinion of students|management fee|cannot code)\\b",
      "hidden_emotion": "Systemic Disillusionment & Academic Distress"
    },
    {
      "pattern": "\\b(as expected|of course|naturally)\\b.*\\b(failed|delayed|wrong)\\b",
      "hidden_emotion": "Cynical Resignation & Distrust"
    },
    {
      "pattern": "\\b(urgent|asap|immediately|critical)\\b.*\\b(please|help|kindly)\\b",
      "hidden_emotion": "Masked Panic for Timely Resolution"
    },
    {
      "pattern": "\\b(sorry|apologies|my fault)\\b.*\\b(however|but|because of)\\b",
      "hidden_emotion": "Defensive Guilt & Resentment"
    },
    {
      "pattern": "\\b(hope|wish|maybe|trying|will see)\\b.*\\b(despite|failure|issue|problem)\\b",
      "hidden_emotion": "Guarded Hope Under Extreme Fatigue"
    }
  ]
}